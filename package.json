{
	"$schema": "https://json.schemastore.org/package.json",
	"private": true,
	"name": "@shfs/root",
	"imports": {
		"#compiler": "./packages/compiler/src/index.ts",
		"#compiler/*": "./packages/compiler/src/*.ts",
		"#harness": "./test/harness.ts",
		"#shfs": "./packages/shfs/src/index.ts",
		"#shfs/*": "./packages/shfs/src/*.ts"
	},
	"catalog": {
		"@tsconfig/bun": "1.0.10",
		"@types/bun": "1.3.11",
		"tsdown": "0.21.4",
		"@typescript/native-preview": "7.0.0-dev.20260322.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@tsconfig/bun": "catalog:",
		"@types/bun": "catalog:",
		"turbo": "^2",
		"effect": "4.0.0-beta.91",
		"ultracite": "7.0.11"
	},
	"scripts": {
		"publish": "bun run script/publish.ts",
		"build": "turbo run build",
		"check": "ultracite check",
		"fix": "ultracite fix",
		"typecheck": "turbo run typecheck"
	},
	"packageManager": "bun@1.3.11",
	"workspaces": [
		"packages/*",
		"examples/*"
	]
}
